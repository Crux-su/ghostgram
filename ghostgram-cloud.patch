diff --git a/build-system/sideload_build.py b/build-system/sideload_build.py
new file mode 100644
index 00000000..ac37b29d
--- /dev/null
+++ b/build-system/sideload_build.py
@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+"""Full device build for later Sideloadly signing; never imports Apple credentials."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import plistlib
+import re
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+from types import SimpleNamespace
+import zipfile
+
+
+def configuration(env, mode, bundle_id):
+    if not re.fullmatch(r'[A-Za-z][A-Za-z0-9-]*(?:\.[A-Za-z0-9-]+){2,}', bundle_id):
+        raise ValueError('Invalid bundle ID')
+    if bundle_id in ('ph.telegra.Telegraph', 'org.ghostgram.app'):
+        raise ValueError('Use a separate bundle ID for the sideload build')
+    if mode not in ('check', 'package'):
+        raise ValueError('Unknown build mode')
+    api_id, api_hash = ('1', '0' * 32) if mode == 'check' else (env.get('TG_API_ID', ''), env.get('TG_API_HASH', ''))
+    if not re.fullmatch(r'[1-9][0-9]{0,9}', api_id) or int(api_id) > 2147483647:
+        raise ValueError('Set TG_API_ID to your Telegram application ID in repository secrets')
+    if not re.fullmatch(r'[0-9a-fA-F]{32}', api_hash) or (mode == 'package' and api_hash == '0' * 32):
+        raise ValueError('Set TG_API_HASH to your Telegram application hash in repository secrets')
+    return dict(bundle_id=bundle_id, api_id=api_id, api_hash=api_hash,
+                team_id='0000000000', app_center_id='0', is_internal_build='false',
+                is_appstore_build='false', appstore_id='0', app_specific_url_scheme='ghostgramlocal',
+                premium_iap_product_id='', enable_siri=False, enable_icloud=False)
+
+
+def validate_ipa(path, bundle_id):
+    with zipfile.ZipFile(path) as archive:
+        names = archive.namelist()
+        if archive.testzip() is not None:
+            raise ValueError('Corrupt IPA')
+        infos = [n for n in names if re.fullmatch(r'Payload/[^/]+\.app/Info\.plist', n)]
+        if len(infos) != 1:
+            raise ValueError('Expected exactly one application in IPA')
+        if any('/PlugIns/' in n or '/Watch/' in n for n in names):
+            raise ValueError('Unexpected app extensions or Watch app in sideload IPA')
+        info = plistlib.loads(archive.read(infos[0]))
+        if info.get('CFBundleIdentifier') != bundle_id:
+            raise ValueError('Unexpected IPA bundle ID')
+        if info.get('CFBundleSupportedPlatforms') != ['iPhoneOS']:
+            raise ValueError('Expected an iPhone device IPA')
+        executable = info.get('CFBundleExecutable', '')
+        if not executable or '/' in executable or '\\' in executable:
+            raise ValueError('Invalid app executable')
+        binary = archive.read(infos[0].removesuffix('Info.plist') + executable)
+        if len(binary) < 32:
+            raise ValueError('Missing Mach-O device executable')
+        magic, cpu, _, _, commands, command_bytes, _, _ = struct.unpack_from('<8I', binary)
+        if magic != 0xfeedfacf or cpu != 0x100000c or 32 + command_bytes > len(binary):
+            raise ValueError('Expected a thin arm64 device executable')
+        offset, device = 32, False
+        for _ in range(commands):
+            if offset + 8 > 32 + command_bytes:
+                raise ValueError('Invalid Mach-O load commands')
+            command, size = struct.unpack_from('<2I', binary, offset)
+            if size < 8 or offset + size > 32 + command_bytes:
+                raise ValueError('Invalid Mach-O load command size')
+            if command == 0x32 and size >= 24:
+                device = struct.unpack_from('<I', binary, offset + 8)[0] == 2
+            offset += size
+        if not device:
+            raise ValueError('Mach-O is not built for an iOS device')
+    return {'bundleId': bundle_id, 'platform': 'iOS', 'architecture': 'arm64', 'extensions': False}
+
+
+def run_build(args):
+    root = Path(__file__).resolve().parents[1]
+    os.chdir(root)
+    config = configuration(os.environ, args.mode, args.bundle_id)
+    if platform.system() != 'Darwin' or platform.machine() != 'arm64':
+        raise ValueError('Build requires an Apple Silicon macOS runner')
+    versions = json.loads((root / 'versions.json').read_text())
+    version_output = subprocess.check_output(['xcodebuild', '-version'], text=True)
+    if f"Xcode {versions['xcode']}\n" not in version_output:
+        raise ValueError(f"Select Xcode {versions['xcode']} from versions.json before building")
+    if shutil.disk_usage(root).free < 12 * 1024 ** 3:
+        raise ValueError('Less than 12 GiB free before dependency fetch/build; runner needs more disk space')
+    if args.build_number < 1:
+        raise ValueError('Build number must be positive')
+    print(version_output.strip(), flush=True)
+    print('Building unsigned arm64 iOS app, without extensions. Mode:', args.mode, flush=True)
+    subprocess.run(['bash', 'build-system/GGXcodeConfig.sh'], check=True)
+    # Reuse the exact two upstream submodule patches without requiring its local config.
+    patches = (
+        ('build-system/bazel-rules/rules_apple', 'rules_apple-strip-shell-env.patch'),
+        ('submodules/TgVoipWebrtc/tgcalls', 'tgcalls-call-camera-masks.patch'),
+    )
+    for folder, filename in patches:
+        patch = str(root / 'build-system/GGPatches' / filename)
+        command = ['git', '-C', folder, 'apply']
+        if subprocess.run(command + ['--check', patch], capture_output=True).returncode == 0:
+            subprocess.run(command + [patch], check=True)
+        elif subprocess.run(command + ['--reverse', '--check', patch], capture_output=True).returncode != 0:
+            raise ValueError(f'Upstream patch does not apply: {filename}')
+    sys.path.insert(0, str(root / 'build-system/Make'))
+    import Make
+    if Make.PostboxImportCheck.run(str(root)) != 0:
+        raise ValueError('Upstream Postbox import check failed')
+    with tempfile.TemporaryDirectory(prefix='ghostgram-build-') as temporary:
+        config_path = Path(temporary) / 'config.json'
+        config_path.write_text(json.dumps(config))
+        config_path.chmod(0o600)
+        bazel = Make.locate_bazel(base_path=str(root), cache_host_or_path=None, cache_dir=None)
+        command = Make.BazelCommandLine(bazel=bazel, override_bazel_version=False,
+                                       override_xcode_version=False, bazel_user_root=None)
+        Make.resolve_configuration(str(root), command, SimpleNamespace(
+            configurationPath=str(config_path), gitCodesigningRepository=None,
+            codesigningInformationPath=None, xcodeManagedCodesigning=True), None)
+        command.set_configuration('release_arm64')
+        command.set_build_number(args.build_number)
+        command.set_disable_provisioning_profiles()
+        # Supported by the pinned rules_apple codesigning_support.bzl, unlike apple.codesign=0.
+        command.common_build_args.extend([
+            '--features=disable_legacy_signing', '--//Telegram:disableExtensions',
+            '--define=GG_SIDELOAD=1', '--swiftcopt=-DGG_SIDELOAD',
+            '--jobs=2', '--local_resources=memory=4096',
+        ])
+        # Avoid dSYM output on the small hosted runner; always build the full application.
+        command.configuration_args = [a for a in command.configuration_args
+                                      if a not in ('--apple_generate_dsym', '--output_groups=+dsyms')]
+        command.invoke_build()
+    ipa = root / 'bazel-bin/Telegram/Telegram.ipa'
+    metadata = validate_ipa(ipa, args.bundle_id)
+    out = root / 'build-output/sideload'
+    out.mkdir(parents=True, exist_ok=True)
+    metadata.update(mode=args.mode, commit=subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip(),
+                    xcode=versions['xcode'], buildNumber=args.build_number, signed=False,
+                    deviceTested=False, simulatorTested=False)
+    if args.mode == 'package':
+        destination = out / 'Ghostgram-Sideload.ipa'
+        shutil.copyfile(ipa, destination)
+        digest = hashlib.sha256(destination.read_bytes()).hexdigest()
+        metadata['sha256'] = digest
+        (out / 'SHA256SUMS.txt').write_text(f'{digest}  Ghostgram-Sideload.ipa\n')
+    (out / 'build-info.json').write_text(json.dumps(metadata, indent=2) + '\n')
+    print('Build verified. ' + ('IPA ready for re-signing.' if args.mode == 'package' else 'Check-only: no installable IPA published.'))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--mode', choices=['check', 'package'], default='check')
+    parser.add_argument('--bundle-id', default='org.ghostgram.local')
+    parser.add_argument('--build-number', type=int, default=1)
+    try:
+        run_build(parser.parse_args())
+    except (ValueError, OSError, subprocess.CalledProcessError) as error:
+        print(f'Build failed: {error}', file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/build-system/tests/test_sideload_build.py b/build-system/tests/test_sideload_build.py
new file mode 100644
index 00000000..d2071377
--- /dev/null
+++ b/build-system/tests/test_sideload_build.py
@@ -0,0 +1,74 @@
+import importlib.util
+import plistlib
+import struct
+import tempfile
+import unittest
+import zipfile
+from pathlib import Path
+
+SPEC = importlib.util.spec_from_file_location('sideload_build', Path(__file__).parents[1] / 'sideload_build.py')
+build = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(build)
+
+
+class SideloadBuildTests(unittest.TestCase):
+    def test_missing_credentials_never_produce_installable_configuration(self):
+        with self.assertRaisesRegex(ValueError, 'TG_API_ID'):
+            build.configuration({}, 'package', 'org.ghostgram.local')
+
+    def test_compile_check_uses_placeholder_credentials(self):
+        config = build.configuration({}, 'check', 'org.ghostgram.local')
+        self.assertEqual(config['api_id'], '1')
+        self.assertEqual(config['api_hash'], '0' * 32)
+        self.assertFalse(config['enable_icloud'])
+
+    def test_secrets_validated_without_echo(self):
+        secret = 'secret-invalid-value'
+        with self.assertRaises(ValueError) as result:
+            build.configuration({'TG_API_ID': '1234', 'TG_API_HASH': secret}, 'package', 'org.ghostgram.local')
+        self.assertNotIn(secret, str(result.exception))
+
+    def test_bundle_id_cannot_inject_build_configuration(self):
+        with self.assertRaises(ValueError):
+            build.configuration({}, 'check', 'bad\"\nvalue')
+
+    def test_valid_credentials(self):
+        result = build.configuration({'TG_API_ID': '1234', 'TG_API_HASH': 'a' * 32}, 'package', 'org.ghostgram.local')
+        self.assertEqual(result['team_id'], '0000000000')
+        self.assertEqual(result['api_id'], '1234')
+
+    def archive(self, folder, platform=2, extensions=False):
+        path = Path(folder) / 'app.ipa'
+        # A minimal arm64 Mach-O with LC_BUILD_VERSION; platform 2 is device iOS, 7 simulator.
+        binary = struct.pack('<8I', 0xfeedfacf, 0x100000c, 0, 2, 1, 24, 0, 0)
+        binary += struct.pack('<6I', 0x32, 24, platform, 0, 0, 0)
+        info = {'CFBundleIdentifier': 'org.ghostgram.local', 'CFBundleExecutable': 'Ghostgram', 'CFBundleSupportedPlatforms': ['iPhoneOS']}
+        with zipfile.ZipFile(path, 'w') as z:
+            z.writestr('Payload/Ghostgram.app/Info.plist', plistlib.dumps(info))
+            z.writestr('Payload/Ghostgram.app/Ghostgram', binary)
+            if extensions:
+                z.writestr('Payload/Ghostgram.app/PlugIns/Test.appex/Info.plist', b'test')
+        return path
+
+    def test_accepts_device_archive(self):
+        with tempfile.TemporaryDirectory() as d:
+            self.assertEqual(build.validate_ipa(self.archive(d), 'org.ghostgram.local')['platform'], 'iOS')
+
+    def test_rejects_arm64_simulator_despite_iphoneos_plist(self):
+        with tempfile.TemporaryDirectory() as d:
+            with self.assertRaisesRegex(ValueError, 'device'):
+                build.validate_ipa(self.archive(d, platform=7), 'org.ghostgram.local')
+
