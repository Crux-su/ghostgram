@@ -0,0 +1,74 @@
+import Foundation
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import ItemListUI
+import PromptUI
+import GGCore
+
+func ggMakeLocalProfileScreen(context: AccountContext) -> ViewController {
+    let account = context.account.id.gg
+    weak var controllerRef: ItemListController?
+    let model = combineLatest(queue: .mainQueue(), GGLocalProfile.state.signal(for: account), GGLocalization.shared.languageCodeSignal)
+    |> map { value, _ -> GGPEScreenModel in
+        var model = GGPEScreenModel(title: GGStrings.LocalProfile.title)
+        model.sections.append([
+            GGPERow(id: "enabled", kind: .toggle(title: GGStrings.LocalProfile.enabled, value: value.enabled, enabled: true)),
+            GGPERow(id: "info", kind: .footer(GGStrings.LocalProfile.info))
+        ])
+        model.toggle["enabled"] = { enabled in GGLocalProfile.update(account: account) { $0.enabled = enabled } }
+        let fields: [(String, String, String, String)] = [
+            ("usernames", GGStrings.LocalProfile.usernames, value.usernames.map { "@\($0)" }.joined(separator: ", "), GGStrings.LocalProfile.usernameHint),
+            ("numbers", GGStrings.LocalProfile.numbers, value.numbers.joined(separator: ", "), GGStrings.LocalProfile.numberHint),
+            ("rating", GGStrings.LocalProfile.rating, value.rating.map { String($0) } ?? "", GGStrings.LocalProfile.ratingHint),
+            ("gram", GGStrings.LocalProfile.gram, value.gram.map { String($0) } ?? "", GGStrings.LocalProfile.gramHint)
+        ]
+        var rows: [GGPERow] = []
+        for (id, title, current, hint) in fields {
+            rows.append(GGPERow(id: id, kind: .disclosure(title: title, label: current.isEmpty ? GGStrings.LocalProfile.original : current, icon: nil, enabled: true)))
+            model.tap[id] = {
+                controllerRef?.present(promptController(context: context, text: title, subtitle: hint, value: current, placeholder: "", characterLimit: 300, apply: { input in
+                    guard let input else { return }
+                    let text = input.trimmingCharacters(in: .whitespacesAndNewlines)
+                    var valid = true
+                    GGLocalProfile.update(account: account) { state in
+                        switch id {
+                        case "usernames":
+                            if let values = GGLocalProfile.usernames(text) { state.usernames = values } else { valid = false }
+                        case "numbers":
+                            if text.isEmpty { state.numbers = [] }
+                            else if let values = GGLocalProfile.numbers(text) { state.numbers = values } else { valid = false }
+                        case "rating":
+                            if text.isEmpty { state.rating = nil }
+                            else if let number = GGLocalProfile.unsigned(text), number <= 1000 { state.rating = Int(number) } else { valid = false }
+                        case "gram":
+                            if text.isEmpty { state.gram = nil }
+                            else if let number = GGLocalProfile.unsigned(text) { state.gram = number } else { valid = false }
+                        default: break
+                        }
+                    }
+                    if !valid { ggPEPresentToast(context: context, from: controllerRef, text: GGStrings.LocalProfile.invalid) }
+                }), in: .window(.root))
+            }
+        }
+        rows.append(GGPERow(id: "premium", kind: .toggle(title: GGStrings.LocalProfile.premium, value: value.premiumBadge, enabled: true)))
+        rows.append(GGPERow(id: "premiumInfo", kind: .footer(GGStrings.LocalProfile.premiumInfo)))
+        model.toggle["premium"] = { enabled in GGLocalProfile.update(account: account) { $0.premiumBadge = enabled } }
+        model.sections.append(rows)
+        let colors = [GGStrings.LocalProfile.original, GGStrings.LocalProfile.blue, GGStrings.LocalProfile.violet, GGStrings.LocalProfile.gold]
+        var colorRows = [GGPERow(id: "colorHeader", kind: .header(GGStrings.LocalProfile.color))]
+        for (index, title) in colors.enumerated() {
+            let id = "color.\(index)"
+            colorRows.append(GGPERow(id: id, kind: .check(title: title, subtitle: nil, checked: value.color == index)))
+            model.tap[id] = { GGLocalProfile.update(account: account) { $0.color = index } }
+        }
+        model.sections.append(colorRows)
+        model.sections.append([GGPERow(id: "reset", kind: .action(title: GGStrings.LocalProfile.reset, destructive: true, enabled: true))])
+        model.tap["reset"] = { GGLocalProfile.state.reset(for: account) }
+        return model
+    }
+    let controller = ggPEMakeListController(context: context, model: model)
+    controllerRef = controller
+    return controller
+}
