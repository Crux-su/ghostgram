diff --git a/Ghostgram/Features/ProfileExport/Sources/LocalProfile/GGLocalProfile.swift b/Ghostgram/Features/ProfileExport/Sources/LocalProfile/GGLocalProfile.swift
new file mode 100644
index 00000000..89c2ad32
--- /dev/null
+++ b/Ghostgram/Features/ProfileExport/Sources/LocalProfile/GGLocalProfile.swift
@@ -0,0 +1,108 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import GGCore
+import GGHooks
+import GGSettingsUI
+
+/// Deliberately separate from Telegram peer data, entitlements and wallet balances.
+/// Excluded from settings export/copy: this is an account's appearance on this device.
+struct GGLocalProfileState: GGSettingValue {
+    var enabled: Bool = false
+    var usernames: [String] = []
+    var numbers: [String] = []
+    var premiumBadge: Bool = false
+    var rating: Int? = nil
+    var gram: Int64? = nil
+    var color: Int = 0
+
+    var nameColor: UIColor? {
+        switch color {
+        case 1: return UIColor.systemBlue
+        case 2: return UIColor.systemPurple
+        case 3: return UIColor.systemOrange
+        default: return nil
+        }
+    }
+}
+
+enum GGLocalProfile {
+    static let state = GGAccountSetting<GGLocalProfileState>("localProfile.appearance", default: GGLocalProfileState(), flags: [.noExport])
+
+    static func declare() { let _ = state }
+
+    static func update(account: GGAccountID, _ change: (inout GGLocalProfileState) -> Void) {
+        var value = state.value(for: account)
+        change(&value)
+        state.set(value, for: account)
+    }
+
+    static func register() {
+        GGPeerInfoHooks.localAppearance.register { context in
+            let value = state.value(for: context.account.id.gg)
+            guard value.enabled else { return GGLocalProfileAppearance() }
+            return GGLocalProfileAppearance(premiumBadge: value.premiumBadge, ratingLevel: value.rating.map { min(1000, max(0, $0)) }, nameColor: value.nameColor)
+        }
+        GGPeerInfoHooks.infoRows.register { request in
+            guard request.peer.id == request.context.account.peerId else { return [] }
+            let value = state.value(for: request.context.account.id.gg)
+            guard value.enabled else { return [] }
+            // No URLs or actions: tapping a local collectible must not resolve a different real user.
+            var rows: [GGPeerInfoRow] = []
+            for (index, username) in value.usernames.prefix(8).enumerated() {
+                rows.append(GGPeerInfoRow(id: "localProfile.username.\(index)", label: GGStrings.LocalProfile.usernames, text: "@\(username)", rightLabel: GGStrings.LocalProfile.localOnly))
+            }
+            for (index, number) in value.numbers.prefix(8).enumerated() {
+                rows.append(GGPeerInfoRow(id: "localProfile.number.\(index)", label: GGStrings.LocalProfile.numbers, text: number, rightLabel: GGStrings.LocalProfile.localOnly))
+            }
+            if let gram = value.gram {
+                rows.append(GGPeerInfoRow(id: "localProfile.gram", label: GGStrings.LocalProfile.gram, text: "\(max(0, gram)) GRAM", rightLabel: GGStrings.LocalProfile.localOnly))
+            }
+            return rows
+        }
+        GGMenuRegistry.register(GGMenuRow(
+            id: "localProfile.screen",
+            section: .main(of: .moreFakeGifts),
+            order: 250,
+            title: { GGStrings.LocalProfile.title },
+            subtitle: { GGStrings.LocalProfile.localOnly },
+            kind: .action({ menu in menu.push(ggMakeLocalProfileScreen(context: menu.context)) }),
+            searchKeywords: { ["Premium", "GRAM", "+888", GGStrings.LocalProfile.usernames] }
+        ))
+    }
+
+    /// Strict parsing: malformed input leaves the current value unchanged.
+    static func usernames(_ text: String) -> [String]? {
+        let tokens = text.split(whereSeparator: { $0 == "," || $0.isWhitespace })
+        guard tokens.count <= 8 else { return nil }
+        var result: [String] = []
+        for token in tokens {
+            let value = token.first == "@" ? String(token.dropFirst()) : String(token)
+            guard (1...32).contains(value.count), value.unicodeScalars.allSatisfy({
+                (48...57).contains($0.value) || (65...90).contains($0.value) || (97...122).contains($0.value) || $0.value == 95
+            }) else { return nil }
+            if !result.contains(where: { $0.lowercased() == value.lowercased() }) { result.append(value) }
+        }
+        return result
+    }
+
+    static func numbers(_ text: String) -> [String]? {
+        let tokens = text.split(whereSeparator: { $0 == "," || $0.isNewline })
+        guard tokens.count <= 8 else { return nil }
+        var result: [String] = []
+        for token in tokens {
+            let value = token.filter { !$0.isWhitespace && $0 != "-" }
+            guard value.hasPrefix("+888"), value.count == 12,
+                  value.dropFirst().unicodeScalars.allSatisfy({ (48...57).contains($0.value) }) else { return nil }
+            if !result.contains(value) { result.append(value) }
+        }
+        return result
+    }
+
+    static func unsigned(_ text: String) -> Int64? {
+        guard !text.isEmpty, text.unicodeScalars.allSatisfy({ (48...57).contains($0.value) }) else { return nil }
+        return Int64(text)
+    }
+}
