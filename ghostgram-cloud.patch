+/// Captured transaction: a non-nil handler must never fall through to a real purchase.
+public typealias GGGiftLocalPurchase = (Bool, String?, [MessageTextEntity]?) -> Signal<Never, BuyStarGiftError>
+
+public enum GGGiftPurchaseRoute {
+    case server
+    case local(GGGiftLocalPurchase)
+
+    public var localPurchase: GGGiftLocalPurchase? {
+        if case let .local(commit) = self { return commit }
+        return nil
+    }
+
+    public static func capture(context: AccountContext, gift: StarGift.UniqueGift, recipientPeerId: EnginePeer.Id) -> GGGiftPurchaseRoute {
+        for provider in GGGiftViewHooks.localPurchase.handlers {
+            if let commit = provider(context, gift, recipientPeerId) { return .local(commit) }
+        }
+        return .server
+    }
+}
